+++ b/taurus-rc/source/harness/tabbar/minimize-check.c
@@ -0,0 +1,38 @@
+// cc -I../../tweak/Sources minimize-check.c -lm -o minimize-check && ./minimize-check
+#include <assert.h>
+#include <stdio.h>
+#include "Redesigned/Navbar/MinimizeStep.h"
+
+int main(void) {
+    SGRMinimizeTrack t = {0, false};
+    assert(!SGRMinimizeStep(&t, 23, 0, 1000));
+    assert(SGRMinimizeStep(&t, 24, 0, 1000));
+    assert(SGRMinimizeStep(&t, 100, 0, 1000));
+    assert(SGRMinimizeStep(&t, 77, 0, 1000));
+    assert(!SGRMinimizeStep(&t, 76, 0, 1000));
+    assert(SGRMinimizeStep(&t, 100, 0, 1000));
+    // Bottom overscroll and its spring-back must not look like a direction reversal.
+    assert(SGRMinimizeStep(&t, 1100, 0, 1000));
+    assert(SGRMinimizeStep(&t, 1000, 0, 1000));
+    assert(!SGRMinimizeStep(&t, 976, 0, 1000));
+    // Insets and a bounce at the top always restore the original navbar.
+    t = (SGRMinimizeTrack){200, true};
+    assert(!SGRMinimizeStep(&t, -120, -64, 1000));
+    assert(!SGRMinimizeStep(&t, -64, -64, 1000));
+    // A short page does not collapse. A shortened page at its top must still expand.
+    t = (SGRMinimizeTrack){0, false};
+    assert(!SGRMinimizeStep(&t, 100, 0, 119));
+    t = (SGRMinimizeTrack){200, true};
+    assert(!SGRMinimizeStep(&t, 0, 0, 50));
+    t = (SGRMinimizeTrack){200, true};
+    assert(!SGRMinimizeStep(&t, 0, 0, -50));
+    // Rapid reversals remain repeatable; sub-threshold jitter does not change state.
+    t = (SGRMinimizeTrack){0, false};
+    for (int i = 0; i < 100; i++) {
+        assert(SGRMinimizeStep(&t, 24, 0, 1000));
+        assert(SGRMinimizeStep(&t, 20, 0, 1000));
+        assert(!SGRMinimizeStep(&t, 0, 0, 1000));
+    }
+    puts("PASS: collapse, reversal, jitter, insets, overscroll, short pages, repeated transitions");
+    return 0;
+}
diff --git a/taurus-rc/source/harness/tabbar/test_repack_ui.py b/taurus-rc/source/harness/tabbar/test_repack_ui.py
new file mode 100644
index 0000000..b079ff5
--- /dev/null
+++ b/taurus-rc/source/harness/tabbar/test_repack_ui.py
@@ -0,0 +1,62 @@
+import importlib.util
+import struct
+import tempfile
+import unittest
+import zipfile
+from pathlib import Path
+
+SCRIPT = Path(__file__).resolve().parents[2] / "scripts/repack-ui-ipa.py"
+spec = importlib.util.spec_from_file_location("repack_ui", SCRIPT)
+module = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(module)
+
+
+class RepackTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.ipa = self.root / "original.ipa"
+        self.dylib = self.root / "built.dylib"
+        self.output = self.root / "updated.ipa"
+        self.dylib.write_bytes(struct.pack("<8I", 0xFEEDFACF, 0x0100000C, 0, 6, 0, 0, 0, 0))
+        self.entries = {
+            "Payload/Spotify.app/Spotify": b"original executable",
+            "Payload/Spotify.app/Info.plist": b"original plist",
+            "Payload/Spotify.app/Frameworks/spotifyglass.dylib": b"old UI library",
+            "Payload/Spotify.app/PlugIns/Widget.appex/Widget": b"original extension",
+            "Payload/Spotify.app/icon.png": b"original icon",
+        }
+        with zipfile.ZipFile(self.ipa, "w", compression=zipfile.ZIP_DEFLATED) as archive:
+            archive.comment = b"original archive comment"
+            for name, data in self.entries.items():
+                archive.writestr(name, data)
+
+    def test_only_ui_library_changes(self):
+        original = self.ipa.read_bytes()
+        target = module.repack(self.ipa, self.dylib, self.output)
+        self.assertEqual(self.ipa.read_bytes(), original)
+        with zipfile.ZipFile(self.output) as archive:
+            self.assertEqual(archive.namelist(), list(self.entries))
+            self.assertEqual(archive.comment, b"original archive comment")
+            for name, data in self.entries.items():
+                self.assertEqual(archive.read(name), self.dylib.read_bytes() if name == target else data)
+
+    def test_refuses_to_overwrite_inputs_or_existing_output(self):
+        with self.assertRaises(ValueError):
+            module.repack(self.ipa, self.dylib, self.ipa)
+        self.output.write_bytes(b"previous build")
+        with self.assertRaises(FileExistsError):
+            module.repack(self.ipa, self.dylib, self.output)
+        self.assertEqual(self.output.read_bytes(), b"previous build")
+
+    def test_rejects_uncompiled_or_wrong_platform_replacement(self):
+        for invalid in (b"source code", struct.pack("<8I", 0xFEEDFACF, 7, 0, 6, 0, 0, 0, 0)):
+            self.dylib.write_bytes(invalid)
+            with self.assertRaises(ValueError):
+                module.repack(self.ipa, self.dylib, self.output)
+            self.assertFalse(self.output.exists())
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/taurus-rc/source/scripts/repack-ui-ipa.py b/taurus-rc/source/scripts/repack-ui-ipa.py
new file mode 100644
index 0000000..3e1dab5
--- /dev/null
+++ b/taurus-rc/source/scripts/repack-ui-ipa.py
@@ -0,0 +1,76 @@
+#!/usr/bin/env python3
+"""Replace only spotifyglass.dylib in an existing IPA; signing is a separate step."""
+import argparse
+import copy
+import hashlib
+import re
+import shutil
+import struct
+import zipfile
+from pathlib import Path
+
+
+def repack(ipa: Path, dylib: Path, output: Path) -> str:
+    if output.resolve() in (ipa.resolve(), dylib.resolve()):
+        raise ValueError("Output must be a new file, separate from both inputs")
+    replacement = dylib.read_bytes()
+    if len(replacement) < 32:
+        raise ValueError("The replacement is not a compiled dylib")
+    magic, cpu, _, kind = struct.unpack_from("<IIII", replacement)
+    if (magic, cpu, kind) != (0xFEEDFACF, 0x0100000C, 6):
+        raise ValueError("Expected a 64-bit ARM64 Mach-O dylib from the tweak build")
+    with zipfile.ZipFile(ipa) as source:
+        names = source.namelist()
+        if len(set(names)) != len(names):
+            raise ValueError("The input IPA has duplicate archive entries")
+        targets = [n for n in names if re.fullmatch(r"Payload/[^/]+\.app/Frameworks/spotifyglass\.dylib", n)]
+        if len(targets) != 1:
+            raise ValueError("Expected exactly one existing spotifyglass.dylib in the IPA")
+        target = targets[0]
+        # Exclusive creation preserves the original IPA and any previous build.
+        with output.open("xb") as stream:
+            try:
+                with zipfile.ZipFile(stream, "w") as result:
+                    result.comment = source.comment
+                    for entry in source.infolist():
+                        info = copy.copy(entry)
+                        if info.filename == target:
+                            result.writestr(info, replacement)
+                        else:
+                            with source.open(entry) as old, result.open(info, "w") as new:
+                                shutil.copyfileobj(old, new, length=1024 * 1024)
+                # Audit all contents after repacking, including the executable, icons and extensions.
+                with zipfile.ZipFile(output) as result:
+                    if result.namelist() != names:
+                        raise ValueError("Archive entry list changed unexpectedly")
+                    for name in names:
+                        expected = hashlib.sha256(replacement).digest() if name == target else digest(source, name)
+                        if digest(result, name) != expected:
+                            raise ValueError(f"Content verification failed: {name}")
+            except BaseException:
+                stream.close()
+                output.unlink(missing_ok=True)
+                raise
+    return target
+
+
+def digest(archive: zipfile.ZipFile, name: str) -> bytes:
+    with archive.open(name) as stream:
+        return hashlib.file_digest(stream, "sha256").digest()
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("ipa", type=Path)
+    parser.add_argument("dylib", type=Path)
+    parser.add_argument("output", type=Path)
+    args = parser.parse_args()
+    target = repack(args.ipa, args.dylib, args.output)
+    print(f"Replaced: {target}")
+    print("Verified: every other archive entry has identical contents")
+    print(f"Output: {args.output}")
+    print("Re-sign this IPA with your normal sideloading tool before installing.")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/taurus-rc/source/tweak/Sources/Redesigned/Navbar/BottomGradient.x b/taurus-rc/source/tweak/Sources/Redesigned/Navbar/BottomGradient.x
new file mode 100644
index 0000000..401927f
--- /dev/null
+++ b/taurus-rc/source/tweak/Sources/Redesigned/Navbar/BottomGradient.x
@@ -0,0 +1,48 @@
+// The host's explicit CAGradientLayer is not the only fade: iOS 26 draws a bottom scroll-edge
+// effect behind floating bars too. Suppress it on the tab's pages while the switch is off.
+// Keep the top effect, the system tab bar's material and all player/other-sheet effects intact.
+#import "Core/SGCore.h"
+#import "Navbar.h"
+
+static NSHashTable<UIScrollView *> *sg_lists;
+static char kBottomHiddenKey;
+
+static void updateBottomEdge(UIScrollView *list) {
+    if (@available(iOS 26.0, *)) {
+        NSNumber *original = objc_getAssociatedObject(list, &kBottomHiddenKey);
+        BOOL pageList = SGRTabBarContainsPageView(list) && list.bounds.size.height >= 150;
+        for (UIView *parent = list.superview; pageList && parent; parent = parent.superview) {
+            if ([parent isKindOfClass:UIScrollView.class]) pageList = NO;
+        }
+        BOOL suppress = !SGFlag(SGRKeyNavbarBottomGradient, YES) && pageList;
+        if (suppress) {
+            if (!original) objc_setAssociatedObject(list, &kBottomHiddenKey, @(list.bottomEdgeEffect.hidden), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+            if (!list.bottomEdgeEffect.hidden) list.bottomEdgeEffect.hidden = YES;
+        } else if (original) {
+            objc_setAssociatedObject(list, &kBottomHiddenKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+            list.bottomEdgeEffect.hidden = original.boolValue;
+        }
+    }
+}
+
+void SGRRefreshBottomEdgeEffects(void) {
+    for (UIScrollView *list in sg_lists.allObjects) updateBottomEdge(list);
+}
+
+%hook UIScrollView
+- (void)didMoveToWindow {
+    %orig;
+    if (!sg_lists) sg_lists = [NSHashTable weakObjectsHashTable];
+    [sg_lists addObject:self];
+    updateBottomEdge(self);
+}
+- (void)layoutSubviews {
+    %orig;
+    updateBottomEdge(self);
+}
+%end
+
+%ctor {
+    if (!SGRedesignedUI()) return;
+    %init;
+}
